generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  STANDARD
  PRO
  ENTERPRISE
}

model Tenant {
  id                String   @id @default(uuid())
  name              String
  plan              Plan     @default(STANDARD)
  domain            String   @unique
  connectionString  String?  
  themeConfig       Json?    // Armazena as cores e logo do cliente
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  products          Product[]
  roles             Role[]
  metadata          EntityMetadata[]
}

// Tabela de Metadados: Define como cada tela aparece para cada cliente
model EntityMetadata {
  id          String   @id @default(uuid())
  entity      String   // ex: "PRODUCT", "VEHICLE", "SUPPLIER"
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  fields      Json     // Array de definições de campos (ordem, labels, triggers)
  tabs        Json?    // Definição de abas/pastas
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entity, tenantId])
  @@index([tenantId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  isActive  Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions Permission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid())
  action      String
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id              String   @id @default(uuid())
  name            String
  price           Decimal
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  // A "gaveta" de dados customizados
  additionalData  Json?    
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}
