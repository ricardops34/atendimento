generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  STANDARD
  PRO
  ENTERPRISE
}

model Tenant {
  id                String   @id @default(uuid())
  name              String
  plan              Plan     @default(STANDARD)
  domain            String   @unique
  connectionString  String?  
  themeConfig       Json?    
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  products          Product[]
  roles             Role[]
  metadata          EntityMetadata[]
  customEntities    DynamicEntity[]
}

// Definição de uma "Tabela Virtual" criada pelo cliente
model DynamicEntity {
  id          String   @id @default(uuid())
  name        String   // ex: "Histórico de Lavagem", "Acessórios"
  slug        String   // ex: "historico-lavagem"
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  fields      Json     // Definição das colunas dessa tabela virtual
  
  records     DynamicRecord[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, tenantId])
  @@index([tenantId])
}

// Armazenamento dos dados de todas as tabelas virtuais
model DynamicRecord {
  id                String   @id @default(uuid())
  entityId          String
  entity            DynamicEntity @relation(fields: [entityId], references: [id])
  
  tenantId          String
  
  // O "Vínculo" com tabelas padrão (opcional)
  // Pode ser o ID de um Veículo, Cliente, etc.
  parentId          String?  
  parentEntity      String?  // ex: "VEHICLE", "SUPPLIER"

  data              Json     // Os valores salvos pelo cliente

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([entityId])
  @@index([tenantId])
  @@index([parentId])
}

model EntityMetadata {
  id          String   @id @default(uuid())
  entity      String   
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  fields      Json     
  tabs        Json?    
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entity, tenantId])
  @@index([tenantId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions Permission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([name, tenantId])
}

model Permission {
  id          String   @id @default(uuid())
  action      String
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id              String   @id @default(uuid())
  name            String
  price           Decimal
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  additionalData  Json?    
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId])
}
