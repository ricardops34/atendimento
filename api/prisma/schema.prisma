generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  maxUsers          Int      @default(5)
  maxBranches       Int      @default(1)
  maxRecords        Int      @default(5000)
  features          Json?    
  tenants           Tenant[]
  routines          PlanRoutine[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Tenant {
  id                String   @id @default(uuid())
  name              String   // Nome do Grupo
  domain            String   @unique
  logoUrl           String?  
  email             String?  
  status            TenantStatus @default(ACTIVE)
  isActive          Boolean  @default(true)
  planId            String
  plan              Plan     @relation(fields: [planId], references: [id])
  companies         Company[]
  branches          Branch[]
  users             User[]
  roles             Role[]
  entities          MetadataEntity[]
  metadataFields    MetadataField[]
  routines          TenantRoutine[]
  accessControls    AccessControl[]
  auditLogs         AuditLog[]
  dynamicEntities   DynamicEntity[]
  dynamicRecords    DynamicRecord[]
  customRoutines    CustomRoutine[]
  products          Product[]
  themeConfig       Json?
  customLimits      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Company {
  id          String   @id @default(uuid())
  name        String   // Razão Social
  tradeName   String?  // Nome Fantasia
  document    String   @unique // CNPJ
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  branches    Branch[]
  users       UsersOnCompanies[]
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId])
}

enum TenantStatus {
  ACTIVE
  OVERDUE
  SUSPENDED
  CANCELLED
}

// --- CADASTROS AUXILIARES (IBGE / FISCAL) ---

model Country {
  id        String   @id @default(uuid())
  code      String   @unique // Código BACEN
  name      String   
  isoCode   String?  // Ex: BRA
  branches  Branch[]
  createdAt DateTime @default(now())
}

model State {
  id        String   @id @default(uuid())
  code      Int      @unique // Código IBGE
  name      String   
  uf        String   @unique // Sigla (SP, RJ...)
  cities    City[]
  createdAt DateTime @default(now())
}

model City {
  id        String   @id @default(uuid())
  code      Int      @unique // Código IBGE
  name      String   
  cnpjCode  String?  // Código TOM (Receita Federal)
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  ceps      Cep[]
  createdAt DateTime @default(now())
}

model Cep {
  id           String   @id @default(uuid())
  code         String   @unique
  address      String?
  neighborhood String?
  cityId       String
  city         City     @relation(fields: [cityId], references: [id])
  createdAt    DateTime @default(now())
}

model Cnae {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  branches    BranchCnae[]
}

// --- FIM AUXILIARES ---

model Branch {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id])
  isMain            Boolean  @default(false)
  name              String   
  tradeName         String?  
  document          String   @unique 
  personType        String   @default("J") 
  stateRegistration String?  
  foundationDate    DateTime? 
  email             String?
  phone             String?
  responsibleName   String?
  domain            String?  @unique
  logoUrl           String?  
  primaryColor      String?  @default("#003551")
  secondaryColor    String?  @default("#ffffff")

  // Endereço Fiscal
  zipCode           String?
  address           String?
  number            String?
  complement        String?
  neighborhood      String?
  city              String?
  state             String?
  countryId         String?
  country           Country? @relation(fields: [countryId], references: [id])

  cnaes             BranchCnae[]
  users             UsersOnBranches[]
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([tenantId])
  @@index([companyId])
}

model BranchCnae {
  id          String   @id @default(uuid())
  cnaeId      String
  cnae        Cnae     @relation(fields: [cnaeId], references: [id])
  isMain      Boolean  @default(false)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
}

model Routine {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String   
  module      String   
  icon        String?  
  link        String?  
  type        String   @default("S")
  levelMin    Int      @default(1)
  hookName    String?  
  description String?  
  plans       PlanRoutine[]
  tenants     TenantRoutine[]
  access      AccessControl[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlanRoutine {
  id          String   @id @default(uuid())
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id])
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id])
  @@unique([planId, routineId])
}

model TenantRoutine {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id])
  isActive    Boolean  @default(true)
  @@unique([tenantId, routineId])
}

model AccessControl {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id])
  targetType  String   
  targetId    String   
  canView     Boolean  @default(true)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MetadataEntity {
  id          String   @id @default(uuid())
  name        String   
  label       String   
  type        String   @default("U")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  fields      MetadataField[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([name, tenantId])
}

model MetadataField {
  id                String   @id @default(uuid())
  entityId          String
  entity            MetadataEntity @relation(fields: [entityId], references: [id])
  name              String   
  type              String   
  isSystem          String   @default("U")
  titleForm         String?  
  titleList         String?  
  helpText          String?  
  order             Int      @default(0)
  isActiveForm      String   @default("S")
  isActiveList      String   @default("S")
  mask              String?  
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model User {
  id              String   @id @default(uuid())
  login           String   @unique
  email           String   @unique
  password        String
  name            String?
  avatarUrl       String?
  level           Int      @default(1)
  status          String   @default("ACTIVE") // ACTIVE, BLOCKED, INACTIVE
  
  // Limites Operacionais
  backdateDays    Int      @default(0)
  futureDateDays  Int      @default(0)
  workSchedule    Json?    // Dias e horários de trabalho
  
  blockedAt       DateTime?
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  roleId          String?
  role            Role?    @relation(fields: [roleId], references: [id])
  
  // Relacionamentos N:N
  companies       UsersOnCompanies[]
  branches        UsersOnBranches[]
  allowedMenus    UsersOnMenus[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UsersOnCompanies {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  isDefault Boolean  @default(false)
  @@id([userId, companyId])
}

model UsersOnBranches {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  isDefault Boolean  @default(false)
  @@id([userId, branchId])
}

model UsersOnMenus {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id])
  @@id([userId, menuId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions Permission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([name, tenantId])
}

model Permission {
  id        String   @id @default(uuid())
  name      String   
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity      String?  
  details     Json
  userId      String
  tenantId    String
  ipAddress   String?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

// --- DADOS PÚBLICOS CNPJ (RFB) ---

model CnpjEmpresa {
  cnpjBasico         String   @id
  razaoSocial        String
  naturezaJuridica   String
  qualificacaoResp   String
  capitalSocial      Float
  porteEmpresa       String
  enteFederativo     String?
  estabelecimentos   CnpjEstabelecimento[]
  socios             CnpjSocio[]
  createdAt          DateTime @default(now())
  @@index([razaoSocial])
}

model CnpjEstabelecimento {
  id                    String   @id @default(uuid())
  cnpjBasico           String
  cnpjOrdem            String
  cnpjDv               String
  identificadorMatriz  Int      // 1-Matriz, 2-Filial
  nomeFantasia         String?
  situacaoCadastral    String
  dataSituacao         String?
  motivoSituacao       String?
  nomeCidadeExterior   String?
  paisId               String?
  dataInicioAtividade  String?
  cnaeFiscalPrincipal  String
  cnaeFiscalSecundaria String?
  tipoLogradouro       String?
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  cep                  String?
  uf                   String?
  municipio            String?
  ddd1                 String?
  telefone1            String?
  ddd2                 String?
  telefone2            String?
  dddFax               String?
  fax                  String?
  email                String?
  situacaoEspecial     String?
  dataSituacaoEspecial String?
  empresa              CnpjEmpresa @relation(fields: [cnpjBasico], references: [cnpjBasico])
  createdAt          DateTime @default(now())

  @@index([cnpjBasico])
  @@index([nomeFantasia])
  @@index([cep])
  @@index([uf])
  @@index([municipio])
}

model CnpjSocio {
  id                    String   @id @default(uuid())
  cnpjBasico           String
  identificadorSocio   Int
  nomeSocio            String
  cnpjCpfSocio         String?
  qualificacaoSocio    String?
  dataEntradaSociedade String?
  paisId               String?
  representanteLegal   String?
  nomeRepresentante    String?
  qualificacaoRepLegal String?
  faixaEtaria          String?
  empresa              CnpjEmpresa @relation(fields: [cnpjBasico], references: [cnpjBasico])
  createdAt          DateTime @default(now())

  @@index([cnpjBasico])
  @@index([nomeSocio])
}

model CnpjAuxiliary {
  id          String   @id @default(uuid())
  type        String   // CNAE, MUNIC, PAIS, NATU, QUAL, MOTI
  code        String
  description String
  createdAt   DateTime @default(now())

  @@unique([type, code])
  @@index([type])
}

model DynamicEntity {
  id          String   @id @default(uuid())
  name        String
  slug        String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  fields      Json?    
  records     DynamicRecord[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([slug, tenantId])
}

model DynamicRecord {
  id          String   @id @default(uuid())
  entityId    String
  entity      DynamicEntity @relation(fields: [entityId], references: [id])
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomRoutine {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  hookName    String   
  version     Int      @default(1)
  description String?
  filePath    String   
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, hookName])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MenuType {
  SIDEBAR
  TOOLBAR
}

model ImportStatus {
  id          String   @id @default(uuid())
  type        String   // Ex: 'RFB_EMPRESAS', 'RFB_ESTABELECIMENTOS'
  status      String   // 'PENDING', 'PROCESSING', 'COMPLETED', 'FAILED'
  progress    Float    @default(0)
  totalFiles  Int      @default(0)
  currentFile Int      @default(0)
  message     String?
  error       String?
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MenuModule {
  SAAS
  SISTEMA
}

model Menu {
  id        String   @id @default(uuid())
  module    MenuModule @default(SISTEMA)
  type      MenuType   @default(SIDEBAR)
  name      String   // Nome que aparece no menu (Label)
  link      String?  // URL/Rota
  icon      String?  // Ícone (an an-...)
  
  parentId  String?  // Para submenus
  parent    Menu?    @relation("MenuToMenu", fields: [parentId], references: [id])
  subMenus  Menu[]   @relation("MenuToMenu")

  group     String?  // Legado/Agrupador simples
  order     Int      @default(0)
  roles     String[] @default(["ADMIN"])
  active    Boolean  @default(true)
  isCloud   Boolean  @default(false)

  users     UsersOnMenus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, module, type], name: "name_module_type")
}
