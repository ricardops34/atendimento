// Configuração do Prisma Client e do Banco PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// SECURITY / AUTH MODELS
// ----------------------------------------------------------------------------

model Empresa {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  userEmpresas  UserEmpresa[]
  clientes      Cliente[]
  profissionais Profissional[]
  contratos     Contrato[]
  agendamentos  Agendamento[]
  feriados      Feriado[]

  @@map("empresas")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  profileId     Int            @map("profile_id")
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  avatar        String         @default("avatar_01.png") @db.VarChar(100)
  password      String         @db.VarChar(255)
  isActive      Boolean        @default(true) @map("is_active")
  userEmpresas  UserEmpresa[]
  profissionais Profissional[]

  @@map("users")
}

model Profile {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  profileModules ProfileModule[]
  users          User[]

  @@unique([name])
  @@map("profiles")
}

model UserEmpresa {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresaId Int     @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  isDefault Boolean @default(false) @map("is_default")

  @@unique([userId, empresaId])
  @@map("user_empresas")
}

model Module {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)
  key  String @unique @db.VarChar(255) // ex: 'companies', 'appointments-calendar'

  profileModules ProfileModule[]
  routines       Routine[]
  menus          Menu[]

  @@map("modules")
}

model ProfileModule {
  id        Int     @id @default(autoincrement())
  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  moduleId  Int     @map("module_id")
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  canRead   Boolean @default(true) @map("can_read")
  canWrite  Boolean @default(false) @map("can_write")

  @@unique([profileId, moduleId])
  @@map("profile_modules")
}

model Routine {
  id         Int     @id @default(autoincrement())
  moduleId   Int     @map("module_id")
  module     Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name       String  @db.VarChar(255)
  key        String  @unique @db.VarChar(255)
  path       String  @db.VarChar(255)
  icon       String? @db.VarChar(100)
  shortLabel String? @map("short_label") @db.VarChar(20)
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")
  menus      Menu[]

  @@map("routines")
}

model Menu {
  id         Int      @id @default(autoincrement())
  moduleId   Int?     @map("module_id")
  module     Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  routineId  Int?     @map("routine_id")
  routine    Routine? @relation(fields: [routineId], references: [id], onDelete: SetNull)
  parentId   Int?     @map("parent_id")
  parent     Menu?    @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Menu[]   @relation("MenuHierarchy")
  label      String   @db.VarChar(255)
  shortLabel String?  @map("short_label") @db.VarChar(20)
  icon       String?  @db.VarChar(100)
  link       String?  @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")

  @@map("menus")
}

// ----------------------------------------------------------------------------
// DOMAIN MODELS
// ----------------------------------------------------------------------------

/// Representa a empresa cliente (Cadastros de Apoio)
model Cliente {
  id             Int        @id @default(autoincrement())
  empresaId      Int        @map("empresa_id")
  empresa        Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome           String     @db.VarChar(255)
  razao          String?    @db.VarChar(255)
  tipoPessoa     String     @default("J") @map("tipo_pessoa") @db.VarChar(1)
  documento      String?    @db.VarChar(20)
  dataNascimento DateTime?  @map("data_nascimento") @db.Date
  cep            String?    @db.VarChar(8)
  bairro         String?    @db.VarChar(255)
  numero         String?    @db.VarChar(50)
  complemento    String?    @db.VarChar(255)
  telefone       String?    @db.VarChar(20)
  email          String?    @db.VarChar(255)
  cor            String?    @db.VarChar(7) // cor padrão na agenda (hex)
  endereco       String?    @db.VarChar(500)
  cidade         String?    @db.VarChar(255)
  estado         String?    @db.VarChar(2)
  contratos      Contrato[]

  @@map("cliente")
}

/// Representa o profissional executor (Cadastros de Apoio)
model Profissional {
  id           Int                    @id @default(autoincrement())
  empresaId    Int                    @map("empresa_id")
  empresa      Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  userId       Int?                   @map("user_id")
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  nome         String                 @db.VarChar(255)
  agendamentos Agendamento[]
  escalas      ContratoItem[]
  contratos    ContratoProfissional[]

  @@map("profissional")
}

/// Representa o contrato de serviço (Cadastros de Apoio)
model Contrato {
  id            Int                    @id @default(autoincrement())
  empresaId     Int                    @map("empresa_id")
  empresa       Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId     Int                    @map("cliente_id")
  cliente       Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  descricao     String                 @db.VarChar(255)
  cor           String                 @default("#333333") @db.VarChar(7)
  dtInicio      DateTime               @map("dt_inicio") @db.Date
  dtFim         DateTime               @map("dt_fim") @db.Date
  tipo          String                 @db.VarChar(1) // F (Fixo), H (Hora)
  valorHora     Decimal?               @map("valor_hora") @db.Decimal(10, 2)
  valorFixo     Decimal?               @map("valor_fixo") @db.Decimal(10, 2)
  isFeriado     Boolean                @default(false) @map("is_feriado") // Flag para identificar dinamicamente o contrato de feriados
  agendamentos  Agendamento[]
  escalas       ContratoItem[]
  profissionais ContratoProfissional[]

  @@map("contrato")
}

/// Pivô many-to-many entre Contrato e Profissional (escala contratual de profissionais habilitados)
model ContratoProfissional {
  id             Int          @id @default(autoincrement())
  contratoId     Int          @map("contrato_id")
  contrato       Contrato     @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  profissionalId Int          @map("profissional_id")
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@unique([contratoId, profissionalId])
  @@map("contrato_profissional")
}

/// Representa a escala semanal recorrente do profissional no contrato (Cadastros de Apoio)
model ContratoItem {
  id             Int          @id @default(autoincrement())
  contratoId     Int          @map("contrato_id")
  contrato       Contrato     @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  profissionalId Int          @map("profissional_id")
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  diaSemana      Int          @map("dia_semana") // 0 (Domingo) a 6 (Sábado)
  horaInicio     String       @map("hora_inicio") @db.VarChar(5) // hh:ii
  horaFim        String       @map("hora_fim") @db.VarChar(5) // hh:ii
  intervaloIni   String       @map("intervalo_ini") @db.VarChar(5) // hh:ii
  intervaloFim   String       @map("intervalo_fim") @db.VarChar(5) // hh:ii

  @@map("contrato_item")
}

/// Representa os apontamentos de atendimentos (Agendamentos)
model Agendamento {
  id                   Int           @id @default(autoincrement())
  empresaId            Int           @map("empresa_id")
  empresa              Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId           Int?          @map("contrato_id")
  contrato             Contrato?     @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  profissionalId       Int?          @map("profissional_id")
  profissional         Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  descricao            String        @db.VarChar(500)
  dataAgenda           DateTime      @map("data_agenda") @db.Date
  horaInicio           String        @map("hora_inicio") @db.VarChar(5)
  horaFim              String        @map("hora_fim") @db.VarChar(5)
  horaIntervaloInicial String        @default("00:00") @map("hora_intervalo_inicial") @db.VarChar(5)
  horaIntervaloFinal   String        @default("00:00") @map("hora_intervalo_final") @db.VarChar(5)
  duracaoMinutos       Int           @map("duracao_minutos") // Novo! Gravação em minutos inteiros líquidos
  horarioInicial       DateTime      @map("horario_inicial") @db.Timestamptz // Datetime composto formatado
  horarioFinal         DateTime      @map("horario_final") @db.Timestamptz // Datetime composto formatado
  local                String        @default("P") @db.VarChar(1) // P (Presencial), R (Remoto), F (Falta)
  tipo                 String        @default("A") @db.VarChar(1) // A (Agendada), R (Realizada), C (Cancelada), F (Feriado)
  cor                  String        @default("#333333") @db.VarChar(7)
  observacao           String?       @db.Text
  realizados           Realizado[]

  @@map("agendamento")
}

/// Representa os atendimentos realizados faturados (Agendamentos)
model Realizado {
  id            Int         @id @default(autoincrement())
  agendamentoId Int         @map("agendamento_id")
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  horasDecimais Decimal     @map("horas_decimais") @db.Decimal(5, 2) // Novo! Horas líquidas decimais para faturamento

  @@map("realizado")
}

model Feriado {
  id        Int      @id @default(autoincrement())
  empresaId Int      @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  data      DateTime @db.Date
  descricao String   @db.VarChar(255)
  tipo      String   @default("N") @db.VarChar(1) // N (Nacional), M (Municipal), E (Estadual), C (Customizado)
  fixo      Boolean  @default(true)
  municipio String?  @db.VarChar(255)

  @@unique([empresaId, data])
  @@map("feriado")
}

// ----------------------------------------------------------------------------
// GLOBAL SUPPORT MODELS (Cadastros Globais sem Tenant)
// ----------------------------------------------------------------------------

model Estado {
  id    Int    @id
  nome  String @db.VarChar(255)
  sigla String @unique @db.VarChar(2)

  municipios Municipio[]
  ceps       Cep[]

  @@map("estado")
}

model Municipio {
  id       Int    @id
  estadoId Int    @map("estado_id")
  estado   Estado @relation(fields: [estadoId], references: [id], onDelete: Restrict)
  nome     String @db.VarChar(255)

  ceps Cep[]

  @@map("municipio")
}

model Cep {
  cep         String    @id @db.VarChar(8)
  logradouro  String    @db.VarChar(255)
  bairro      String    @db.VarChar(255)
  municipioId Int       @map("municipio_id")
  municipio   Municipio @relation(fields: [municipioId], references: [id], onDelete: Restrict)
  estadoId    Int       @map("estado_id")
  estado      Estado    @relation(fields: [estadoId], references: [id], onDelete: Restrict)

  @@map("cep")
}
