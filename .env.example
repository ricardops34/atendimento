# Configurações de Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atendimento?schema=public"

# Configurações de Segurança
JWT_SECRET="sua_chave_secreta_super_segura_aqui"
JWT_EXPIRES_IN="1d"

# Chave usada para criptografar em repouso o certificado A1 (.pfx) e a senha dele,
# cadastrados por Analista para emissão da NFS-e. Gere um valor próprio e único em produção
# (ex: openssl rand -base64 32) e NUNCA reutilize o JWT_SECRET.
CERT_ENCRYPTION_KEY="defina_uma_chave_unica_so_para_criptografar_certificados"

# Configurações da API
PORT=3000


# Fuso Horário
TZ="America/Sao_Paulo"
